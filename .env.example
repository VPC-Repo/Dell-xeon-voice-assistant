# Copy to .env and edit. This example targets a many-core Xeon host.
# MAX_SESSIONS is raised from the built-in default of 16 to 48.
#
#   cp .env.example .env

# ---------------------------------------------------------------- server
# BIND_HOST 127.0.0.1 keeps the gateway on loopback. Use 0.0.0.0 to reach
# it from other machines on the LAN -- but read the microphone note in the
# README first: browsers only grant mic access on localhost or HTTPS.
BIND_HOST=127.0.0.1
BIND_PORT=8080
# JSON list. Empty means same-origin only, which is what you want locally.
ALLOWED_ORIGINS=[]
# Shared bearer token for session, voice, readiness, and metrics endpoints.
# Empty is allowed only when BIND_HOST is loopback. Generate a long random
# value before binding to a LAN address; keep the local .env out of Git.
AUTH_TOKEN=
LOG_LEVEL=INFO

# "real" runs the actual models. "mock" runs the whole pipeline with
# canned recognition, a canned reply and tone audio -- no models, no
# downloads, useful for checking the WebRTC path end to end.
ADAPTER_MODE=real

# ------------------------------------------------------------------- llm
# SGLang serving Qwen3-30B-A3B-Instruct-2507-FP8 on CPU with the
# intel_amx attention backend -- see deployment/sglang/. The adapter
# speaks plain OpenAI-compatible streaming, so another runtime can be
# substituted here, but this is the configuration the rest of the
# settings are tuned for.
LLM_BASE_URL=http://127.0.0.1:8000
LLM_MODEL=qwen3_30b_a3b
LLM_API_KEY=
# "none" sends nothing, which is right for the Instruct model above.
# "disabled" asks the runtime to turn off thinking mode -- needed if you
# substitute a reasoning model, which otherwise emits a long preamble
# before anything speakable.
LLM_THINKING_MODE=none
LLM_MAX_TOKENS=384
LLM_TEMPERATURE=0.7
LLM_HISTORY_MAX_TOKENS=3000
# Optional file whose contents are appended to the system prompt. Use it
# to give the assistant a persona and a body of facts to answer from.
# Example: prompts/grocery-store.txt
PROMPT_CONTEXT_FILE=

# ------------------------------------------------------- speech-to-text
# Streaming recognition. Decodes while the person is still talking, so
# end of speech costs milliseconds instead of a full pass over the
# utterance, and it returns punctuated, cased text -- which the
# segmenter, endpointing and echo heuristics all depend on. Weights
# download on first use.
STT_MOONSHINE_V2_ARCH=medium-streaming
STT_MOONSHINE_V2_DIR=models/moonshine-v2
STT_SAMPLE_RATE=16000
# ------------------------------------------------------- text-to-speech
TTS_BASE_URL=http://127.0.0.1:8082
TTS_VOICE=default
TTS_SAMPLE_RATE=24000

# ----------------------------------------------------- acknowledgment
# A short prepared phrase ("Sure." / "Let me check.") played while the
# answer is still generating, so the person is not left in silence. It is
# a comfort cue, not a latency fix -- it does not make the answer arrive
# sooner.
ACK_INJECT=true
# Milliseconds after end of speech to start it. Below ~600 it can step on
# people who pause mid-sentence; above ~1200 the silence is noticeable.
ACK_AT_MS=800
# Comma-separated overrides. Empty uses the built-in sets.
ACK_PHRASES=
ACK_PHRASES_BUSY=
# Use the longer phrase set when at least this many answers are already
# generating. 0 disables the long tier.
ACK_LONG_WHEN_BUSY=2

# ------------------------------------------------------------- capacity
# Concurrent sessions admitted. Also sizes the streaming recognizer pool
# (one instance per possible speaker), so raising it costs memory.
# Measure capacity on your host before increasing this value.
MAX_SESSIONS=48
# Answers generating at once. More overlap raises throughput until the
# model's memory bandwidth saturates, after which every stream slows.
# Four is a reasonable starting point on a CPU-only host.
MAX_ACTIVE_GENERATIONS=4
# Session creations per minute across the gateway process. 0 uses the built-in limit.
SESSION_CREATES_PER_MIN=0
MAX_SESSION_SECONDS=14400
MAX_UTTERANCE_SECONDS=30
MAX_TEXT_INPUT_CHARS=2000

# --------------------------------------------------------------- webrtc
STUN_URLS=stun:stun.cloudflare.com:3478
# A TURN relay is only needed for people behind strict or symmetric NAT.
TURN_URL=
TURN_USERNAME=
TURN_PASSWORD=
# Cloudflare Realtime TURN: the gateway mints short-lived credentials.
CF_TURN_KEY_ID=
CF_TURN_API_TOKEN=
CF_TURN_TTL_S=14400

# ------------------------------------------------------------- playback
PLAYBACK_FIRST_PREBUFFER_MS=120
PLAYBACK_REBUFFER_MS=240

# ----------------------------------------------- turn taking and voice
VAD_AGGRESSIVENESS=2
VAD_PRE_ROLL_MS=300
VAD_START_MS=120
# Silence that ends an utterance. Lower feels snappier but cuts people off
# mid-thought; higher is patient but adds that long to every turn.
VAD_END_SILENCE_MS=550
SPECULATIVE_SILENCE_MS=300
# A shorter end-of-speech window when the transcript already reads as a
# complete question.
SEMANTIC_END_SILENCE_MS=350
# Barge-in: speech over the assistant cancels the reply.
BARGE_IN_CONFIRM_MS=250
BARGE_IN_MIN_RMS=350
UTTERANCE_MIN_RMS=250
# Drop recognized text that matches what was just spoken aloud -- the
# microphone hearing the speaker when echo cancellation is imperfect.
ECHO_SUPPRESS_SIMILARITY=0.72
ECHO_SUPPRESS_WINDOW_S=15

# ----------------------------------------------------------- segmenting
# How the streamed answer is cut into speakable fragments. The first
# segment is deliberately allowed to be short: it is what ends the silence
# after the question, and releasing it at the first complete clause rather
# than the first full sentence is the single largest latency win here.
SEGMENT_FIRST_MIN_WORDS=4
SEGMENT_FIRST_MIN_CHARS=16
SEGMENT_MIN_WORDS=8
SEGMENT_MIN_CHARS=40
SEGMENT_MAX_CHARS=140
SEGMENT_MAX_WAIT_MS=1500

# ------------------------------------------------------------------ misc
# Serve a frontend build from somewhere other than frontend/dist.
FRONTEND_DIST=
